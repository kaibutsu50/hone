{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "hone",
  "homepage": "https://github.com/kaibutsu50/hone",
  "items": [
    {
      "name": "Core",
      "type": "registry:lib",
      "title": "Core",
      "description": "全コンポーネントが依存する headless 層（フォーカス・ナビゲーション・dismiss）",
      "files": [
        { "path": "Core/Runtime/Hone.Core.asmdef", "type": "registry:lib" },
        { "path": "Core/Runtime/Core.uss", "type": "registry:lib" },
        { "path": "Core/Runtime/BackStack.cs", "type": "registry:lib" },
        { "path": "Core/Runtime/IDismissable.cs", "type": "registry:lib" },
        { "path": "Core/Runtime/FocusScope.cs", "type": "registry:lib" },
        { "path": "Core/Editor/Hone.Core.Editor.asmdef", "type": "registry:lib" },
        { "path": "Core/Editor/HoneSync.cs", "type": "registry:lib" }
      ],
      "registryDependencies": [],
      "dependencies": [],
      "classes": ["Hone.Core.BackStack", "Hone.Core.IDismissable", "Hone.Core.FocusScope", "Hone.Core.Editor.HoneSync"]
    },
    {
      "name": "Button",
      "type": "registry:ui",
      "title": "Button",
      "description": "variant（default / outline / ghost / destructive）を持つボタン",
      "files": [
        { "path": "UI/Button/Button.cs", "type": "registry:ui" },
        { "path": "UI/Button/Button.uxml", "type": "registry:ui" },
        { "path": "UI/Button/Button.uss", "type": "registry:ui" },
        { "path": "UI/Button/README.md", "type": "registry:ui" }
      ],
      "registryDependencies": ["Core"],
      "dependencies": [],
      "classes": ["Hone.Button"]
    },
    {
      "name": "Dialog",
      "type": "registry:ui",
      "title": "Dialog",
      "description": "フォーカスの trap と復元、Cancel で閉じる動作を FocusScope と BackStack に委ねたダイアログ",
      "files": [
        { "path": "UI/Dialog/Dialog.cs", "type": "registry:ui" },
        { "path": "UI/Dialog/Dialog.uxml", "type": "registry:ui" },
        { "path": "UI/Dialog/Dialog.uss", "type": "registry:ui" },
        { "path": "UI/Dialog/README.md", "type": "registry:ui" }
      ],
      "registryDependencies": ["Core", "Button"],
      "dependencies": [],
      "classes": ["Hone.Dialog"]
    },
    {
      "name": "MessageWindow",
      "type": "registry:ui",
      "title": "MessageWindow",
      "description": "複数ページの文章を 1 ページずつ出し、Submit で次へ送るメッセージウィンドウ（文字送りを持ち、既定は即時表示）",
      "files": [
        { "path": "UI/MessageWindow/MessageWindow.cs", "type": "registry:ui" },
        { "path": "UI/MessageWindow/MessageWindow.uxml", "type": "registry:ui" },
        { "path": "UI/MessageWindow/MessageWindow.uss", "type": "registry:ui" },
        { "path": "UI/MessageWindow/README.md", "type": "registry:ui" }
      ],
      "registryDependencies": ["Core"],
      "dependencies": [],
      "classes": ["Hone.MessageWindow"]
    },
    {
      "name": "Default",
      "type": "registry:theme",
      "title": "Default",
      "description": "トークン定義とテーマの雛形",
      "files": [
        { "path": "Tokens.uss", "type": "registry:theme" },
        { "path": "HoneTheme.tss", "type": "registry:theme" }
      ],
      "registryDependencies": ["Core"],
      "dependencies": [],
      "classes": []
    }
  ]
}
