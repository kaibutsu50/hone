/* 縦のスクロールバーの見た目だけを整える。幅とつまみの角丸は Tokens.uss のトークン。
 * shadcn の Scroll Area（幅 w-2.5、つまみは bg-border の rounded-full、矢印ボタンは持たない）に合わせる。
 * セレクタは .hone-scroll-area の子孫の形で書き、スクロールの振る舞いは ScrollView の標準のまま使う */
.hone-scroll-area .unity-scroller--vertical {
    width: var(--hone-size-scrollbar);
    background-color: transparent;
    border-width: 0;
}

.hone-scroll-area .unity-scroller__low-button,
.hone-scroll-area .unity-scroller__high-button {
    display: none;
}

/* 既定テーマは、スライダーの上下に矢印ボタンの分の余白（24px）と、最小幅（24px）を付けている。矢印を消したので、余白と最小幅を外して、幅をスクロールバーに合わせる */
.hone-scroll-area .unity-scroller__slider {
    width: 100%;
    min-width: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.hone-scroll-area .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

/* 既定テーマのつまみは position: absolute で left: 3px、width: 18px。スクロールバーの幅いっぱいにする */
.hone-scroll-area .unity-base-slider__dragger {
    left: 0;
    width: 100%;
    background-color: var(--hone-color-border);
    border-radius: var(--hone-radius-scrollbar);
    border-width: 0;
}

.hone-scroll-area .unity-base-slider__dragger-border {
    display: none;
}
