/* 色は shadcn の zinc（light）、角丸は shadcn の --radius（0.5rem）を px にしたもの。余白とフォントサイズは Tailwind の既定（4px 刻み、text-sm / base / lg）、枠の太さ（--hone-border-width）は 1px。
 * テーマ切替は無く、1 セットのみ。
 * フォントの --hone-font-body は同梱しないのでここには書かない。HoneTheme.tss の :root に利用者が書く。 */
:root {
    --hone-color-background: #ffffff;
    --hone-color-foreground: #09090b;
    --hone-color-primary: #18181b;
    --hone-color-primary-foreground: #fafafa;
    --hone-color-secondary: #f4f4f5;
    --hone-color-secondary-foreground: #18181b;
    --hone-color-muted: #f4f4f5;
    --hone-color-muted-foreground: #71717a;
    --hone-color-accent: #f4f4f5;
    --hone-color-accent-foreground: #18181b;
    --hone-color-destructive: #ef4444;
    --hone-color-destructive-foreground: #fafafa;
    --hone-color-border: #e4e4e7;
    /* ring は border で描くので、primary（#18181b）と同色だと Default variant で色が変わらず見えない。primary と白の両方に対して見える中間色にする */
    --hone-color-ring: #a1a1aa;
    /* Dialog の overlay。shadcn と同じ黒の半透明 */
    --hone-color-overlay: rgba(0, 0, 0, 0.5);

    --hone-radius-sm: 4px;
    --hone-radius-md: 6px;
    --hone-radius-lg: 8px;

    --hone-space-1: 4px;
    --hone-space-2: 8px;
    --hone-space-3: 12px;
    --hone-space-4: 16px;
    --hone-space-5: 20px;
    --hone-space-6: 24px;
    --hone-space-7: 28px;
    --hone-space-8: 32px;

    --hone-font-size-sm: 14px;
    --hone-font-size-md: 16px;
    --hone-font-size-lg: 18px;

    --hone-border-width: 1px;

    /* Dialog の content の最大幅。shadcn の max-w-lg（32rem） */
    --hone-size-dialog: 512px;

    --hone-ring-width: 2px;
    /* 未使用。Core.uss の ring は border で描くので、offset を表現できない */
    --hone-ring-offset: 2px;

    /* Dialog の opt-in variant（.hone-dialog--blur）の backdrop-filter。var() は blur() の中に書けないので完成形で持つ */
    --hone-backdrop-blur: blur(8px);
}
