/* モデルルームの前提の検証（#56）。RoomExp.tss から @import する。コンポーネントの USS ではないので、トークン規約の対象外 */

/* ---- 実験の配置（見た目だけの都合） ---- */
.room-exp-stage {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-start;
}

.room-exp-column {
    padding: 12px;
    margin: 8px;
    background-color: rgb(24, 24, 27);
    color: rgb(250, 250, 250);
}

.room-exp-heading {
    font-size: 14px;
    color: rgb(161, 161, 170);
    margin-top: 8px;
    margin-bottom: 4px;
}

.room-exp-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

/* ---- (a) :focus の background-image でカーソル / (d) 範囲を絞った規則 ---- */

/* Button を親の幅に引き伸ばさない。フォーカスで幅が変わらないことを、内容で決まる幅で測る */
.room-exp-menu {
    align-items: flex-start;
}

/* (d) の対照。.room-exp の外で同じく border-width: 0 を置き、フォーカスで Core.uss の ring（--hone-ring-width）になることを確かめる */
.room-exp-ring-control .hone-button {
    border-width: 0;
    color: rgb(250, 250, 250);
}

/* フォーカスの有無に関係なく同じ padding-left と border-width を置き、フォーカスで幅が変わらないようにする。
 * この規則だけでは、フォーカス時に Core.uss の ring（クラス 3 つ分の詳細度）が border-width を変える。下の (d) の :focus の規則と組で効く */
.room-exp .hone-button {
    padding-left: 20px;
    border-width: 0;
    -unity-text-align: middle-left;
    color: rgb(250, 250, 250);
}

.room-exp .hone-button:focus {
    background-image: url("RoomExpCursor.png");
    background-position-x: left 6px;
    background-position-y: center;
    background-repeat: no-repeat;
    background-size: 8px 8px;
}

/* Core.uss の ring（.hone-focusable.hone-focusable:focus の border-width）に、範囲を絞った規則が勝つか */
.room-exp .hone-focusable.hone-focusable:focus {
    border-width: 0;
}

/* ---- (d) 範囲を絞ったフォント ---- */
/* DotGothic16.asset は (c) の推奨値（RASTER_HINTED、sampling 16、atlas Point）。このビットマップの atlas は Advanced Text Generator では字形が壊れた
 * （6000.7.0b2。確かめたのは DotGothic16 の RASTER_HINTED、sampling 16、atlas の Point と Bilinear だけ）ので、範囲の中だけ Standard の生成器にする。
 * font-size は sampling の 16 の整数倍にする */
.room-exp {
    --hone-font-body: url("project://database/Assets/Hone/Sandbox/Fonts/DotGothic16.asset?fileID=11400000&guid=0ca85d51ff7f9e14fa49cd7c1a1b0d09&type=2#DotGothic16");
    -unity-text-generator: standard;
}

.room-exp .hone-text {
    font-size: 16px;
}

/* ---- (b) ループするアニメーション ---- */
.room-exp-blink {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    background-color: rgb(250, 250, 250);
}

/* uss: USS の animation-name。値は @keyframes の名前ではなく UIAnimationClip のアセット（6000.7.0b2） */
.room-exp-blink--uss {
    animation-name: url("RoomExpBlink.asset");
    animation-iteration-count: infinite;
}

/* schedule: schedule.Execute(...).Every(ms) で is-dim を付け外しし、transition で動かす。experimental は C# で opacity を書くので、USS の規則を持たない */
.room-exp-blink--schedule {
    transition-property: opacity;
    transition-duration: 0.2s;
}

.room-exp-blink--schedule.is-dim {
    opacity: 0;
}

/* ---- (c) ピクセルフォントのにじみ ---- */
.room-exp-font {
    color: rgb(250, 250, 250);
    margin-bottom: 4px;
}

.room-exp-font--16 {
    font-size: 16px;
}

.room-exp-font--32 {
    font-size: 32px;
}

.room-exp-font--sdfaa {
    -unity-font-definition: url("project://database/Assets/Hone/Sandbox/Experiments/RoomExp/Fonts/DotGothic16-SDFAA.asset?fileID=11400000&guid=b795598daf809a1438dc6bdd3c1d1e97&type=2#DotGothic16-SDFAA");
}

.room-exp-font--sdfaa-hinted16 {
    -unity-font-definition: url("project://database/Assets/Hone/Sandbox/Experiments/RoomExp/Fonts/DotGothic16-SDFAAHinted16.asset?fileID=11400000&guid=5aea7fff9127e3944b7b057df3db6710&type=2#DotGothic16-SDFAAHinted16");
}

.room-exp-font--raster16point {
    -unity-font-definition: url("project://database/Assets/Hone/Sandbox/Experiments/RoomExp/Fonts/DotGothic16-Raster16Point.asset?fileID=11400000&guid=41a4df5103289e1499c9be4a5a992e37&type=2#DotGothic16-Raster16Point");
}

/* ビットマップの atlas が Advanced Text Generator 固有で壊れるのかを見るための対照 */
.room-exp-font--standard {
    -unity-text-generator: standard;
}

/* ---- (e) 文字送り ---- */
.room-exp-typewriter {
    width: 180px;
    margin-right: 12px;
    margin-bottom: 8px;
    font-size: 16px;
    white-space: normal;
    color: rgb(250, 250, 250);
    background-color: rgb(39, 39, 42);
}
