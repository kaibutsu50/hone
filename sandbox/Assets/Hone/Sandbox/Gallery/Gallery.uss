/* sandbox の撮影用の見た目。コンポーネントの USS ではないので、トークン規約（実値を書かない）の対象外。
 * 背景と文字色は Hone のトークン（light の 1 セット）に合わせる。暗い背景だと、ring（近い暗色）が写らない。 */

/* dropdown と ScrollView を包む。背景をここに置かないと、dropdown の背後にシーンのカメラ映像が透ける */
.gallery-page {
    flex-grow: 1;
    padding: 8px;
    background-color: var(--hone-color-background);
}

.gallery-page Label {
    color: var(--hone-color-foreground);
}

.gallery {
    flex-grow: 1;
}

/* 言語の選択。全列に作用するので列の上に置き、幅は中身に合わせる */
.gallery-language {
    align-self: flex-start;
    margin-bottom: 8px;
}

.gallery .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: flex-start;
}

.gallery-column {
    flex-basis: 0;
    flex-grow: 1;
    margin-right: 8px;
    overflow: hidden;
}

.gallery-heading {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.gallery-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.gallery-tag {
    min-width: 56px;
    opacity: 0.6;
}

/* Hone.Button の列。セルは縦並びで、幅は行の残りを短文と長文で等分する。中身の間を少し空ける */
.gallery-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
}

.gallery-cell > * {
    margin-bottom: 2px;
}

/* Hone.Dialog の列。Dialog は画面を覆う大きさを前提にしているので、他の列より広い固定幅にする。
 * 幅は .gallery-tag の min-width（56）+ 2 つの .gallery-dialog（width + margin-right）に余白を足した値。どちらかを変えたら合わせる */
.gallery-column--hone-dialog {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 380px;
}

/* Hone.Dialog のセル。幅は px で確定させる。割合の幅（flex-basis: 0 から伸ばす幅、width: 40% のどちらも）だと、
 * 中央寄せの content が min-width まで潰れて 1 文字ずつ折り返した（6000.7.0b2）。全面を覆う実際の配置（position: absolute で上下左右 0）では起きない。
 * 広げるほど他の列が狭くなる。overlay が content の周りに見えるよう余白を空ける */
.gallery-dialog {
    width: 160px;
    flex-shrink: 0;
    margin-right: 4px;
    padding: 4px;
}
