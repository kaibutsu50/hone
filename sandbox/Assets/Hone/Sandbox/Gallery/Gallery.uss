/* sandbox の撮影用の見た目。コンポーネントの USS ではないので、トークン規約（実値を書かない）の対象外。
 * 背景と文字色は Hone のトークン（light の 1 セット）に合わせる。暗い背景だと、ring（近い暗色）が写らない。 */
.gallery {
    flex-grow: 1;
    padding: 8px;
    background-color: var(--hone-color-background);
}

.gallery Label {
    color: var(--hone-color-foreground);
}

.gallery .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: flex-start;
}

.gallery-column {
    flex-basis: 0;
    flex-grow: 1;
    margin-right: 8px;
    overflow: hidden;
}

.gallery-heading {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.gallery-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.gallery-tag {
    min-width: 56px;
    opacity: 0.6;
}
