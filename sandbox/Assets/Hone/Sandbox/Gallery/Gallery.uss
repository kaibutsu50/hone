/* sandbox の撮影用の見た目。コンポーネントの USS ではないので、トークン規約（実値を書かない）の対象外。
 * 背景と文字色は Hone のトークン（light の 1 セット）に合わせる。暗い背景だと、ring（近い暗色）が写らない。 */

/* dropdown と、リストと ScrollView の並びを包む。背景をここに置かないと、dropdown の背後にシーンのカメラ映像が透ける */
.gallery-page {
    flex-grow: 1;
    padding: 8px;
    background-color: var(--hone-color-background);
}

.gallery-page Label {
    color: var(--hone-color-foreground);
}

/* 左のリストと右のプレビューの並び */
.gallery-body {
    flex-direction: row;
    flex-grow: 1;
}

/* コンポーネントを選ぶリスト。右の幅に影響されないよう固定幅にする */
.gallery-components {
    width: 200px;
    flex-shrink: 0;
    margin-right: 8px;
}

.gallery {
    flex-grow: 1;
}

/* 言語の選択。選んでいるコンポーネントの 2 行目に作用するので、リストとプレビューの上に置き、幅は中身に合わせる */
.gallery-language {
    align-self: flex-start;
    margin-bottom: 8px;
}

.gallery-heading {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.gallery-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.gallery-tag {
    min-width: 56px;
    opacity: 0.6;
}

/* Hone.Button の列。セルは縦並びで、幅は行の残りを短文と長文で等分する。中身の間を少し空ける */
.gallery-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
}

.gallery-cell > * {
    margin-bottom: 2px;
}

/* Hone.Dialog のセル。基準の幅は px で持つ。割合の幅（flex-basis: 0 から伸ばす幅、width: 40% のどちらも）だと、
 * 中央寄せの content が min-width まで潰れて 1 文字ずつ折り返した（6000.7.0b2）。全面を覆う実際の配置（position: absolute で上下左右 0）では起きない。
 * 基準の幅を px で持ち、行の残りを短文と長文の 2 セルで分けて伸ばす（flex-grow。基準が px なら潰れない。6000.7.0b2）。
 * content は Dialog 自身の最大幅で止まり、周りは overlay になる。overlay が content の周りに見えるよう余白を空ける */
.gallery-dialog {
    width: 480px;
    flex-grow: 1;
    flex-shrink: 0;
    margin-right: 4px;
    padding: 4px;
}

/* Hone.MessageWindow のセル。MessageWindow は親の幅に従うので、幅が中身で決まる行に置くと最小幅まで潰れて 1 文字ずつ折り返す（6000.7.0b2）。
 * 幅の決め方は .gallery-dialog と同じ（基準を px で持ち、行の残りまで伸ばす） */
.gallery-message-window {
    width: 480px;
    flex-grow: 1;
    flex-shrink: 0;
    margin-right: 4px;
}
