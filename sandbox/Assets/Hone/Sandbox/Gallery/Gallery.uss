/* sandbox の撮影用の見た目。コンポーネントの USS ではないので、トークン規約（実値を書かない）の対象外。
 * 外枠（ページ、メニュー、カード、見出し行）の規則は、幅を実値で書き、色・余白・角丸・文字の大きさはトークンを使う。カードの中の台（説明、行、セル）の余白は実値のまま。
 * 背景と文字色は Hone のトークン（light の 1 セット）に合わせる。暗い背景だと、ring（近い暗色）が写らない。
 * 左のメニュー（Hone.ToggleGroup）と、右のカード（見出し行に言語の Hone.Cycle、その下にプレビューの ScrollView）を横に並べる。 */

/* 左のメニューと右のカードを横に並べて包む。背景をここに置かないと、背後にシーンのカメラ映像が透ける */
.gallery-page {
    flex-grow: 1;
    flex-direction: row;
    padding: var(--hone-space-4);
    background-color: var(--hone-color-background);
}

.gallery-page Label {
    color: var(--hone-color-foreground);
}

/* 左のメニューの列。右のカードの幅に影響されないよう固定幅にし、右に区切り線を引く */
.gallery-sidebar {
    width: 200px;
    flex-shrink: 0;
    padding-right: var(--hone-space-4);
    margin-right: var(--hone-space-4);
    border-right-width: var(--hone-border-width);
    border-color: var(--hone-color-border);
}

.gallery-title {
    font-size: var(--hone-font-size-lg);
    -unity-font-style: bold;
    margin-bottom: var(--hone-space-4);
}

/* .gallery-page Label の color に勝つよう、.gallery-page から書く */
.gallery-page .gallery-caption {
    font-size: var(--hone-font-size-sm);
    color: var(--hone-color-muted-foreground);
    margin-bottom: var(--hone-space-2);
}

/* コンポーネントを選ぶメニュー（Hone.ToggleGroup）。下の規則の起点 */
.gallery-components {
}

/* 項目を縦に並べる（ToggleGroup の README の「縦並び」と同じ書き方） */
.gallery-components > .unity-button-group {
    flex-direction: column;
}

/* ToggleGroup.uss の flex-grow: 1 は横並びで幅を分けるためのもの。縦並びでは縦方向に効くので、項目が縦に伸びないよう 0 にする（外したときに伸びるかは確かめていない） */
.gallery-components .hone-button {
    -unity-text-align: middle-left;
    flex-grow: 0;
}

/* accent の背景が白に近いので、選んでいる項目を太字でも示す */
.gallery-components .hone-button:checked {
    -unity-font-style: bold;
}

/* 右のカード。残りの幅を使う */
.gallery-card {
    flex-grow: 1;
    min-width: 0;
    padding: var(--hone-space-4);
    border-width: var(--hone-border-width);
    border-color: var(--hone-color-border);
    border-radius: var(--hone-radius-lg);
}

/* カードの見出し行。左に選んでいるコンポーネントの名前、右に言語の Cycle。言語が変えるのはカードの中の 2 行目なので、カードの見出しに置く */
.gallery-card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--hone-space-3);
    margin-bottom: var(--hone-space-3);
    border-bottom-width: var(--hone-border-width);
    border-color: var(--hone-color-border);
}

.gallery-card__title {
    font-size: var(--hone-font-size-lg);
    -unity-font-style: bold;
}

/* 言語の「Language」と Cycle の並び */
.gallery-language {
    flex-direction: row;
    align-items: center;
}

/* .gallery-page Label の color に勝つよう、.gallery-page から書く */
.gallery-page .gallery-language__label {
    color: var(--hone-color-muted-foreground);
    margin-right: var(--hone-space-2);
}

/* Cycle は横並びの親では幅を与える必要がある（Cycle の README の「World Space での置き方」）。
 * 最も長い選択肢の Chinese (Traditional) が省略記号で切れない幅にする（260px では切れた。6000.7.0b4） */
.gallery-language__cycle {
    width: 280px;
}

.gallery {
    flex-grow: 1;
}

/* 列の上に 1 回だけ出す説明（variant の一覧と UXML の使用例）。言語を切り替えても変わらない */
.gallery-description {
    margin-bottom: 8px;
}

.gallery-description__title {
    -unity-font-style: bold;
    opacity: 0.6;
    margin-top: 4px;
}

/* UXML のインデントを残す */
.gallery-description__text {
    white-space: pre;
}

.gallery-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--hone-space-3);
}

.gallery-tag {
    min-width: 56px;
    opacity: 0.6;
}

/* 複数の部品を縦に積む列（Hone.Button の 4 variant、Hone.Switch と Hone.Toggle の off と on）。セルは縦並びで、幅は行の残りを短文と長文で等分する。中身の間を少し空ける */
.gallery-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
}

.gallery-cell > * {
    margin-bottom: 2px;
}

/* Hone.Dialog のセル。基準の幅は px で持つ。割合の幅（flex-basis: 0 から伸ばす幅、width: 40% のどちらも）だと、
 * 中央寄せの content が min-width まで潰れて 1 文字ずつ折り返した（6000.7.0b2）。全面を覆う実際の配置（position: absolute で上下左右 0）では起きない。
 * 基準の幅を px で持ち、行の残りを短文と長文の 2 セルで分けて伸ばす（flex-grow。基準が px なら潰れない。6000.7.0b2）。
 * content は Dialog 自身の最大幅で止まり、周りは overlay になる。overlay が content の周りに見えるよう余白を空ける */
.gallery-dialog {
    width: 480px;
    flex-grow: 1;
    flex-shrink: 0;
    margin-right: 4px;
    padding: 4px;
}

/* Hone.MessageWindow のセル。MessageWindow は親の幅に従うので、幅が中身で決まる行に置くと最小幅まで潰れて 1 文字ずつ折り返す（6000.7.0b2）。
 * 幅の決め方は .gallery-dialog と同じ（基準を px で持ち、行の残りまで伸ばす） */
.gallery-message-window {
    width: 480px;
    flex-grow: 1;
    flex-shrink: 0;
    margin-right: 4px;
}
