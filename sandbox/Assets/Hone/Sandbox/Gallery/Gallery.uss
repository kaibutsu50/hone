/* sandbox の撮影用の見た目。コンポーネントの USS ではないので、トークン規約（実値を書かない）の対象外。
 * 背景と文字色は Hone のトークン（light の 1 セット）に合わせる。暗い背景だと、ring（近い暗色）が写らない。 */
.gallery {
    flex-grow: 1;
    padding: 8px;
    background-color: var(--hone-color-background);
}

.gallery Label {
    color: var(--hone-color-foreground);
}

.gallery .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: flex-start;
}

.gallery-column {
    flex-basis: 0;
    flex-grow: 1;
    margin-right: 8px;
    overflow: hidden;
}

.gallery-heading {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.gallery-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.gallery-tag {
    min-width: 56px;
    opacity: 0.6;
}

/* Hone.Button の列。セルは縦並びで、幅は行の残りを短文と長文で等分する。中身の間を少し空ける */
.gallery-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
}

.gallery-cell > * {
    margin-bottom: 2px;
}

/* Hone.Dialog の列。Dialog は画面を覆う大きさを前提にしているので、他の列より広い固定幅にする（タグ + 2 セル） */
.gallery-column--hone-dialog {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 380px;
}

/* Hone.Dialog のセル。幅は px で確定させる。割合の幅（flex-basis: 0 から伸ばす幅、width: 40% のどちらも）だと、
 * 中央寄せの content が min-width まで潰れて 1 文字ずつ折り返した（6000.7.0b2）。全面を覆う実際の配置（position: absolute で上下左右 0）では起きない。
 * 幅は、他の列（Hone.Button の省略記号の前の文字）が読める範囲で広くした値。Cancel と OK は content の中で折り返して縦に並ぶ。overlay が content の周りに見えるよう余白を空ける */
.gallery-dialog {
    width: 160px;
    flex-shrink: 0;
    margin-right: 4px;
    padding: 4px;
}
