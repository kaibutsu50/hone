<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hone="Hone">
    <ui:VisualElement class="hone-pause-menu">
        <hone:Dialog name="pause">
            <ui:Label class="hone-dialog__title hone-text" text="Paused" />
            <ui:VisualElement class="hone-pause-menu__items">
                <hone:Button name="resume" text="Resume" />
                <hone:Button name="settings" variant="outline" text="Settings" />
                <hone:Button name="quit" variant="outline" text="Quit" />
            </ui:VisualElement>
        </hone:Dialog>
        <hone:Dialog name="confirm-quit">
            <ui:Label class="hone-dialog__title hone-text" text="Quit the game?" />
            <ui:Label class="hone-dialog__description hone-text" text="Progress since the last save will be lost." />
            <ui:VisualElement class="hone-dialog__footer">
                <hone:Button name="cancel" variant="outline" text="Cancel" />
                <hone:Button name="confirm" variant="destructive" text="Quit" />
            </ui:VisualElement>
        </hone:Dialog>
    </ui:VisualElement>
</ui:UXML>
