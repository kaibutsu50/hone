/* 色は shadcn の zinc（light）、角丸は shadcn の --radius（0.5rem）を px にしたもの。余白とフォントサイズは Tailwind の既定（4px 刻み、text-sm / base / lg / xl / 2xl）、枠の太さ（--hone-border-width）は 1px。
 * テーマ切替は無く、1 セットのみ。
 * フォントの --hone-font-body は同梱しないのでここには書かない。HoneTheme.tss の :root に利用者が書く。 */
:root {
    --hone-color-background: #ffffff;
    --hone-color-foreground: #09090b;
    --hone-color-primary: #18181b;
    --hone-color-primary-foreground: #fafafa;
    --hone-color-secondary: #f4f4f5;
    --hone-color-secondary-foreground: #18181b;
    --hone-color-muted: #f4f4f5;
    --hone-color-muted-foreground: #71717a;
    --hone-color-accent: #f4f4f5;
    --hone-color-accent-foreground: #18181b;
    --hone-color-destructive: #ef4444;
    --hone-color-destructive-foreground: #fafafa;
    --hone-color-border: #e4e4e7;
    /* ring は border で描くので、primary（#18181b）と同色だと Default variant で色が変わらず見えない。primary と白の両方に対して見える中間色にする */
    --hone-color-ring: #a1a1aa;
    /* Dialog の overlay。shadcn と同じ黒の半透明 */
    --hone-color-overlay: rgba(0, 0, 0, 0.5);

    --hone-radius-sm: 4px;
    --hone-radius-md: 6px;
    --hone-radius-lg: 8px;
    /* Switch の track と thumb の角丸。下の --hone-size-switch-height の半分で、両端が半円の stadium になる。
     * --hone-size-switch-height を変えたら、その半分に揃える。thumb が円になるのは --hone-size-switch-thumb がこの値の 2 倍以下のとき。
     * shadcn の rounded-full（9999px）を汎用のトークンにしていないのは、Unity が要素の大きさを超える角丸を縦横の軸ごとに別々に縮めるため。
     * 44×24 の track に 9999px を当てると横 22・縦 12 の楕円弧になり、stadium ではなく楕円に描かれる（6000.7.0b4 で確認）。
     * thumb（20px）には 12px が軸ごとに 10px へ縮んで円になる */
    --hone-radius-switch: 12px;

    --hone-space-1: 4px;
    --hone-space-2: 8px;
    --hone-space-3: 12px;
    --hone-space-4: 16px;
    --hone-space-5: 20px;
    --hone-space-6: 24px;
    --hone-space-7: 28px;
    --hone-space-8: 32px;

    --hone-font-size-sm: 14px;
    --hone-font-size-md: 16px;
    --hone-font-size-lg: 18px;
    --hone-font-size-xl: 20px;
    --hone-font-size-2xl: 24px;

    --hone-border-width: 1px;

    /* Dialog の content の最大幅。shadcn の max-w-lg（32rem） */
    --hone-size-dialog: 512px;
    /* Switch の track と thumb。shadcn の Switch（track は h-6 w-11、thumb は h-5 w-5）を px にしたもの。角丸は上の --hone-radius-switch（高さの半分） */
    --hone-size-switch-width: 44px;
    --hone-size-switch-height: 24px;
    --hone-size-switch-thumb: 20px;

    --hone-ring-width: 2px;
    /* 未使用。Core.uss の ring は border で描くので、offset を表現できない */
    --hone-ring-offset: 2px;

    /* Dialog の opt-in variant（.hone-dialog--blur）の backdrop-filter。var() は blur() の中に書けないので完成形で持つ */
    --hone-backdrop-blur: blur(8px);
}
